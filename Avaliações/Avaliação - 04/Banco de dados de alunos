import 'package:shelf_router/shelf_router.dart';

class Aluno {
  final int id;
  final String nome;
  final String email;
  final int idade;
  final String curso;

  Aluno({
    required this.id,
    required this.nome,
    required this.email,
    required this.idade,
    required this.curso,
  });

  Map<String, dynamic> toJson() {
    return {
      'id': id,
      'nome': nome,
      'email': email,
      'idade': idade,
      'curso': curso,
    };
  }

  factory Aluno.fromJson(Map<String, dynamic> json) {
    return Aluno(
      id: json['id'],
      nome: json['nome'],
      email: json['email'],
      idade: json['idade'],
      curso: json['curso'],
    );
  }
}

